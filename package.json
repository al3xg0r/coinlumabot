{
  "name": "coinlumabot",
  "version": "3.0.0",
  "description": "CoinLuma Telegram Bot on Cloudflare Workers",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "db:create": "wrangler d1 create coinlumabot",
    "db:init": "wrangler d1 execute coinlumabot --file=./schema.sql",
    "secret:telegram": "wrangler secret put TELEGRAM_BOT_TOKEN",
    "secret:coingecko": "wrangler secret put COINGECKO_API_KEY",
    "secret:coinmarketcap": "wrangler secret put COINMARKETCAP_API_KEY",
    "secret:admin": "wrangler secret put ADMIN_CHAT_ID"
  },
  "keywords": [
    "telegram",
    "bot",
    "cryptocurrency",
    "cloudflare",
    "workers"
  ],
  "author": "al3xg0r",
  "license": "MIT",
  "devDependencies": {
    "wrangler": "^4.80.0"
  }
}
